PORT=3000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rizio
DB_PASSWORD=replace-with-random-password
DB_NAME=rizio
JWT_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters
INTERNAL_SECRET=replace-with-at-least-32-random-characters
MQTT_URL=mqtts://localhost:8883
MQTT_USERNAME=rizio-backend
MQTT_PASSWORD=replace-with-random-service-password
MQTT_CA_PATH=./certs/ca.crt
CORS_ORIGIN=https://admin.example.com
TRUST_PROXY=0
FIRMWARE_DIR=./storage/firmware
FIRMWARE_PUBLIC_URL=https://firmware.example.com
COMMAND_TIMEOUT_SECONDS=15
OTA_TIMEOUT_SECONDS=300
# Bootstrap account only; supply through process environment, never commit secrets.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
